# ─────────────────────────────────────────────────────────────
# .env.example — Copier vers .env et adapter les valeurs
# IMPORTANT : ne jamais committer .env (déjà dans .gitignore)
# ─────────────────────────────────────────────────────────────

# Application Flask
SECRET_KEY=changeme-use-a-long-random-string
FLASK_ENV=production
DATABASE_URL=sqlite:///taskflow.db

# Ports exposés (modifiables en cas de conflit)
APP_PORT=5000
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
LOKI_PORT=3100

# Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=changeme-grafana
